{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "revenue_vs_gdp",
  "position": {
    "x": 16,
    "y": 408,
    "z": 8,
    "width": 520,
    "height": 296,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "DimDate.Year",
              "nativeQueryRef": "Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactTaxiDaily"
                    }
                  },
                  "Property": "Revenue USD"
                }
              },
              "queryRef": "FactTaxiDaily.Revenue USD",
              "nativeQueryRef": "Revenue USD"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimGDP"
                    }
                  },
                  "Property": "US GDP (USD)"
                }
              },
              "queryRef": "DimGDP.US GDP (USD)",
              "nativeQueryRef": "US GDP (USD)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Taxi revenue (columns) and US GDP (line) by year'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
