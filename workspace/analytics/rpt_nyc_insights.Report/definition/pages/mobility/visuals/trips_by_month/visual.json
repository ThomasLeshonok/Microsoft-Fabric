{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "trips_by_month",
  "position": {
    "x": 860,
    "y": 408,
    "z": 10,
    "width": 404,
    "height": 296,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "MonthName"
                }
              },
              "queryRef": "DimDate.MonthName",
              "nativeQueryRef": "MonthName"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactTaxiDaily"
                    }
                  },
                  "Property": "Trips per Day"
                }
              },
              "queryRef": "FactTaxiDaily.Trips per Day",
              "nativeQueryRef": "Trips per Day"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Seasonality: trips per day by month'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
